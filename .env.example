# QueryLens Environment Example Template
# Copy this file to .env and fill in real values

# PostgreSQL
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_SSLMODE=require
POSTGRES_URL=

# MySQL
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=
MYSQL_SSLMODE=REQUIRED
MYSQL_URL=

# Explicit local-only convenience; keep disabled for normal authenticated use.
DEVELOPMENT_AUTH_BYPASS=false
SOURCE_PERMITTED_CIDRS=[]
