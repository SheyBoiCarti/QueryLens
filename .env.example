# QueryLens Environment Example Template
# Copy this file to .env and fill in real values.

# Add PostgreSQL and MySQL source connections through the app.
# Connections are saved in the metadata database, with encrypted passwords.

# LLM configuration for natural-language queries
# Providers: live, openai, groq, openrouter
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# Optional override for an OpenAI-compatible endpoint
# LLM_API_BASE=

# QueryLens uses a shared workspace without login.
SOURCE_PERMITTED_CIDRS=[]
